# Canonical URL. Replace with the public HTTPS origin on the VPS.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-a-64-character-random-secret

# Docker publishes only on loopback by default for a local reverse proxy.
BIND_ADDRESS=127.0.0.1
PORT=3001
TRUST_PROXY=true
ALLOW_PUBLIC_REGISTRATION=false

# Optional initial source; admins can change this globally from the dashboard.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
# Server refreshes the one shared SQLite snapshot every 5 minutes.
DATA_SYNC_INTERVAL_SECONDS=300

# Optional daily unfiltered Detail Data CSV backup to Google Drive.
# Upload the service-account JSON in admin settings after deploying with normal Compose.
# Alternatively, use docker-compose.backup.yml for a read-only host-mounted key.
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_BACKUP_DAILY_AT=02:00
GOOGLE_DRIVE_BACKUP_TIMEZONE=Asia/Jakarta

# SMTP is required in production for public registration and verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Dashboard LOP <your_email@gmail.com>"
